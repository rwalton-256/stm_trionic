{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "J-Link",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",
            "device": "STM32F407ZG",
            "interface": "swd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/stm_ecu",
            "svdFile": "${workspaceFolder}/.vscode/STM32F407xx.svd",
            "runToEntryPoint": "main",
            "preLaunchTask": "build"
        },
        {
            "name": "OpenOCD (J-Link)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "configFiles": ["openocd-jlink.cfg"],
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/stm_ecu",
            "svdFile": "${workspaceFolder}/.vscode/STM32F407xx.svd",
            "runToEntryPoint": "main",
            "preLaunchTask": "build"
        }
    ]
}